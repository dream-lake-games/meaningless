							"fieldInstances": [{ "__identifier": "text", "__type": "Array<String>", "__value": [
								"All other cells follow simple rules that Bog found online:",
								"Any live cell with fewer than two neighbors dies from loneliness.",
								"Any live cell with two or three neighbors lives and makes casual small-talk.",
								"Any live cell with more than three neighbors dies from lack of personal space.",
								"Any dead cell with exactly three live neighbors is born.",
								"(Cells are born without their permission.)"
							], "__tile": null, "defUid": 11, "realEditorValues": [
								{
									"id": "V_String",
									"params": ["All other cells follow simple rules that Bog found online:"]
